DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=eatful.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://eatful.example.org
# Inject the dedicated RDS database credentials on the server, URL-encode special characters.
DATABASE_URL=mysql://chihu_user:replace-password@rds.example.internal:3306/chihu
# Optional absolute path of the RDS CA certificate mounted by the operator.
# MYSQL_SSL_CA=/etc/ssl/certs/rds-ca.pem
EATFUL_BASE_URL=https://eatful.example.org
WEB_CONCURRENCY=1
# zq-deploy replaces containers without media mounts: production must use private OSS.
EATFUL_MEDIA_STORAGE=oss
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=replace-with-private-bucket
OSS_PROJECT=chihu
OSS_ACCESS_KEY_ID=replace-with-limited-ram-access-key
OSS_ACCESS_KEY_SECRET=replace-with-limited-ram-secret
# Only needed for short-lived STS credentials, which must be refreshed before expiry.
# OSS_SECURITY_TOKEN=
# Server encryption keyring, NOT a member's AI API Key. Keep stable and back up privately.
# Generate with: python manage.py generate_ai_encryption_key
# First key encrypts; all comma-separated keys can decrypt during rotation.
EATFUL_AI_ENCRYPTION_KEYS=
# Exact trusted public hostnames. HTTPS port 443 only; no wildcard, IP or private network.
EATFUL_AI_ALLOWED_HOSTS=api.openai.com,open.bigmodel.cn,generativelanguage.googleapis.com,api.siliconflow.cn,dashscope.aliyuncs.com,dashscope-intl.aliyuncs.com
# Members configure protocol, URL, model and API Key under /me/ai/.
# Legacy EATFUL_VISION_* settings are ignored. Manual entry always works.
