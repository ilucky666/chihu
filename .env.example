DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=eatful.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://eatful.example.org
POSTGRES_PASSWORD=replace-with-long-unique-password
EATFUL_BASE_URL=https://eatful.example.org
EATFUL_MEDIA_ROOT=/app/media
# Modes: manual | responses | chat_completions. Admin UI can override mode, URL and model.
EATFUL_VISION_MODE=responses
EATFUL_VISION_API_KEY=
EATFUL_VISION_MODEL=
EATFUL_VISION_API_URL=
# Set a full HTTPS endpoint. API keys stay in this environment. Manual entry always works.
